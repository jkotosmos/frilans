# Скопируйте этот файл в .env и заполните значения.
# Никогда не коммитьте .env с реальными секретами в git.

# Строка подключения к БД. Для локальной разработки — SQLite:
DATABASE_URL="file:./dev.db"
# В проде используйте PostgreSQL, например:
# DATABASE_URL="postgresql://user:password@host:5432/artel?schema=public"

# Секрет для подписи сессионных JWT (NextAuth). Обязателен в проде.
# Сгенерировать: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-random-32-byte-base64-string"

# Публичный URL сайта (используется для колбэков auth)
NEXTAUTH_URL="http://localhost:3000"

# Токен бота из @BotFather — нужен только для входа через Telegram Mini App.
# Без него сайт работает как обычно (email/пароль), просто автологин внутри
# Telegram будет показывать ошибку "Вход через Telegram временно недоступен".
# Подробности — в TELEGRAM.md
TELEGRAM_BOT_TOKEN=""
