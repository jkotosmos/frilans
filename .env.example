# Не нужен для обычной разработки: `npm run dev`/`npm run build` в текущей
# статической сборке не обращаются к базе данных (см. README.md — «Текущий
# режим»). Эти переменные нужны только если вы восстанавливаете полную
# динамическую версию (см. DEPLOYMENT.md → «Полная динамическая версия») или
# запускаете scripts/export-static-data.ts / prisma/seed.ts против настоящего
# Postgres. Скопируйте в .env и заполните — никогда не коммитьте .env с
# реальными секретами в git.

# Строка подключения к PostgreSQL. Для локальной разработки быстрее всего
# завести бесплатную базу на neon.tech (у Neon есть бесплатное branch'евание —
# удобно иметь отдельную ветку БД для локальной разработки и отдельную для прода)
# либо поднять Postgres локально: docker run -d -p 5432:5432 -e POSTGRES_PASSWORD=postgres postgres
DATABASE_URL="postgresql://user:password@host:5432/artel?schema=public"

# Секрет для подписи сессионных JWT (NextAuth, динамическая версия). Обязателен в проде.
# Сгенерировать: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-random-32-byte-base64-string"

# Публичный URL сайта (используется для колбэков auth, динамическая версия)
NEXTAUTH_URL="http://localhost:3000"

# Токен бота из @BotFather — динамическая версия, вход через Telegram Mini App.
# Подробности — в TELEGRAM.md
TELEGRAM_BOT_TOKEN=""
